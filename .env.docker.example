API_PORT=8080
DOCKER_NETWORK=church-network

# Isi dengan nama container MySQL yang sudah berjalan di VPS.
DB_HOST=mysql-container-name
DB_PORT=3306
DB_NAME=sahata_worship
DB_USER=church_app
DB_PASSWORD=change_this_database_password

JWT_SECRET=replace_with_at_least_32_random_characters
CORS_ORIGIN=https://domain-frontend-anda.com

# LiveKit self-hosted. Credential ini hanya boleh ada di backend.
LIVEKIT_URL=https://livekit.domain-anda.com
LIVEKIT_WS_URL=wss://livekit.domain-anda.com
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
